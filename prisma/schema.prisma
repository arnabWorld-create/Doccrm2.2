generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("doctor")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Patient {
  id                String                   @id @default(cuid())
  patientId         String                   @unique
  name              String
  age               Int?
  gender            String?
  contact           String?
  address           String?
  bloodGroup        String?
  allergies         String?
  chronicConditions String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  searchVector      Unsupported("tsvector")? @map("search_vector")
  appointments      Appointment[]
  invoices          Invoice[]
  payments          Payment[]
  visits            Visit[]

  @@index([searchVector], map: "idx_patients_search_vector", type: Gin)
  @@map("patients")
}

model Visit {
  id             String       @id @default(cuid())
  patientId      String
  visitDate      DateTime     @default(now())
  visitType      String       @default("Consultation")
  temp           Float?
  spo2           Int?
  pulse          Int?
  bloodPressure  String?
  weight         Float?
  chiefComplaint String?
  signs          String?
  investigations String?
  diagnosis      String?
  treatment      String?
  medicines      String?
  notes          String?
  reports        String?
  referredTo     String?
  followUpDate   DateTime?
  followUpNotes  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bpDiastolic    Int?
  bpSystolic     Int?
  rbs            Int?
  paidBy         String?
  medications    Medication[]
  fees           VisitFee[]
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([visitDate])
  @@index([patientId], map: "idx_visits_patient_id")
  @@index([visitDate], map: "idx_visits_visit_date")
  @@map("visits")
}

model CustomMedicine {
  id         String   @id @default(cuid())
  name       String   @unique
  usageCount Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("custom_medicines")
}

model Medication {
  id           String   @id @default(cuid())
  visitId      String
  medicine     String
  dose         String?
  frequency    String?
  timing       String?
  duration     String?
  startFrom    String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([visitId], map: "idx_medications_visit_id")
  @@map("medications")
}

model ClinicProfile {
  id                  String   @id @default(cuid())
  clinicName          String   @default("Faith Clinic")
  address             String?
  city                String?
  state               String?
  pincode             String?
  phone               String?
  email               String?
  website             String?
  workingHours        String?  @default("Mon-Sat: 9:00 AM - 8:00 PM | Sun: 10:00 AM - 2:00 PM")
  doctorName          String?
  doctorQualification String?
  registrationNumber  String?
  specialization      String?
  logo                String?
  tagline             String?
  invoiceHeader       String?
  invoiceFooter       String?
  receiptHeader       String?
  receiptFooter       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("clinic_profile")
}

model Appointment {
  id                 String   @id @default(cuid())
  patientId          String?
  appointmentDate    DateTime
  appointmentTime    String
  duration           Int      @default(30)
  appointmentType    String   @default("Consultation")
  status             String   @default("Scheduled")
  reason             String?
  notes              String?
  reminderSent       Boolean  @default(false)
  visitId            String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tempPatientContact String?
  tempPatientName    String?
  patient            Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([appointmentDate])
  @@index([status])
  @@index([appointmentDate], map: "idx_appointments_date")
  @@index([patientId], map: "idx_appointments_patient_id")
  @@index([status], map: "idx_appointments_status")
  @@map("appointments")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  patientId     String
  visitId       String?
  amount        Float
  currency      String        @default("INR")
  status        String        @default("pending")
  issuedDate    DateTime      @default(now())
  dueDate       DateTime
  paidDate      DateTime?
  notes         String?
  metadata      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([patientId])
  @@index([status])
  @@index([dueDate])
  @@index([status], map: "idx_invoice_status")
  @@index([patientId], map: "idx_invoices_patient_id")
  @@index([status], map: "idx_invoices_status")
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  discount    Int      @default(0)
  total       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId], map: "idx_invoice_items_invoice_id")
  @@map("invoice_items")
}

model Payment {
  id                String   @id @default(cuid())
  patientId         String
  amount            Float
  currency          String   @default("INR")
  status            String   @default("pending")
  paymentMethod     String?
  provider          String   @default("stripe")
  providerPaymentId String?  @unique
  invoiceId         String?
  description       String?
  metadata          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  invoice           Invoice? @relation(fields: [invoiceId], references: [id])
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt], map: "idx_payments_created_at")
  @@index([patientId], map: "idx_payments_patient_id")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  amount           Float
  reason           String?
  status           String   @default("pending")
  providerRefundId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([paymentId], map: "idx_refunds_payment_id")
  @@map("refunds")
}

model VisitFee {
  id          String   @id @default(cuid())
  visitId     String
  serviceName String
  amount      Float
  quantity    Int      @default(1)
  discount    Float    @default(0)
  total       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_fees")
}

model AnalyticsCache {
  id           String   @id @default(cuid())
  cacheKey     String   @unique
  data         String
  calculatedAt DateTime @default(now())
  expiresAt    DateTime

  @@index([cacheKey])
  @@index([expiresAt])
  @@map("analytics_cache")
}
